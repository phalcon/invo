<?xml version="1.0"?>
<ruleset name="Invo">
    <description>Invo Coding Standards</description>

    <!-- Arguments:
         p = Show progress
         s = Show sniff codes in output
         colors = Force color output (optional, often auto-detected)
    -->
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="Phalcon"/>
    <file>../src</file>
    <file>../config</file>
    <file>../public/index.php</file>
    <file>../tests/Unit</file>
    <file>../tests/Functional</file>
    <file>../tests/Browser</file>
    <file>../tests/Support</file>
    <file>../tests/bootstrap.php</file>
</ruleset>
